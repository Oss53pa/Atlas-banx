# Scrutix - Variables d'environnement
# Copiez ce fichier vers .env et remplissez les valeurs

# ===========================================
# SUPABASE (Backend)
# ===========================================
VITE_SUPABASE_URL=votre-supabase-url
VITE_SUPABASE_ANON_KEY=votre-supabase-anon-key

# ===========================================
# ATLAS STUDIO « PROPH3T CORE » (Federation / hosted ask) — OPTIONNEL
# ===========================================
# Sert a: memoire inter-apps, RAG SYSCOHADA/OHADA/CGI, 197 outils centraux,
# audit chaine SHA-256, et delegation hebergee (proph3t-ask).
#
# OPTIONNEL : si non defini, l'app retombe automatiquement sur VITE_SUPABASE_*
# ci-dessus, car le core mutualise EST aujourd'hui le meme projet Supabase que
# l'app. Ne renseigner ces 2 vars QUE si le core est deplace sur un autre projet.
# NE JAMAIS committer la cle reelle — uniquement via .env / secrets.
VITE_ATLAS_SUPABASE_URL=https://vgtmljfayiysuvrcmunt.supabase.co
VITE_ATLAS_SUPABASE_ANON_KEY=cle-anon-du-core-atlas-studio

# ===========================================
# GOOGLE DRIVE (Sauvegarde Cloud - Optionnel)
# ===========================================
# Pour activer la sauvegarde Google Drive, vous devez:
# 1. Creer un projet sur https://console.cloud.google.com/
# 2. Activer l'API Google Drive
# 3. Creer des identifiants OAuth 2.0 (Application Web)
# 4. Ajouter votre domaine dans les origines JavaScript autorisees
# 5. Copier le Client ID et l'API Key ci-dessous

VITE_GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=votre-api-key

# ===========================================
# CLAUDE AI (Analyse IA - Optionnel)
# ===========================================
# Pour activer l'analyse par intelligence artificielle
# Obtenez votre cle API sur https://console.anthropic.com/

VITE_CLAUDE_API_KEY=votre-cle-api-claude

# ===========================================
# SMTP (Email automatique - Configure dans l'app)
# ===========================================
# La configuration SMTP se fait directement dans:
# Parametres > Organisation > Configuration Email SMTP
