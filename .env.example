# ============================================================================
# AtlasBanx — Variables d'environnement
# Copiez ce fichier vers .env et remplissez les valeurs.
# ============================================================================
# NE JAMAIS committer de clés réelles. Seules les variables préfixées VITE_
# sont exposées au navigateur (front). Les secrets serveur (service role,
# API tierces) se configurent dans les SECRETS des Edge Functions Supabase
# (voir la section « EDGE FUNCTIONS » en bas, informative).
# ============================================================================

# ===========================================
# SUPABASE (Backend) — REQUIS EN PRODUCTION
# ===========================================
# En production avec des données clients réelles, pointez vers VOTRE projet
# Supabase dédié. Sans ces variables, l'app retombe sur un projet mutualisé
# partagé (repli Atlas Studio) — acceptable en démo, À NE PAS utiliser pour
# de vraies données bancaires.
VITE_SUPABASE_URL=votre-supabase-url
VITE_SUPABASE_ANON_KEY=votre-supabase-anon-key

# ===========================================
# MODE DÉMO — DOIT ÊTRE 'false' (ou absent) EN PRODUCTION
# ===========================================
# true : authentification automatique + données fictives, sans Supabase.
# Utile pour une démo/preview ; à désactiver impérativement en production.
VITE_DEMO_MODE=false

# ===========================================
# ATLAS STUDIO « PROPH3T CORE » (Fédération) — OPTIONNEL
# ===========================================
# Mémoire inter-apps, RAG SYSCOHADA/OHADA/CGI, outils centraux, audit SHA-256.
# OPTIONNEL : si non défini, repli automatique sur VITE_SUPABASE_* ci-dessus.
# Ne renseigner QUE si le core est déplacé sur un autre projet Supabase.
VITE_ATLAS_SUPABASE_URL=
VITE_ATLAS_SUPABASE_ANON_KEY=

# ===========================================
# GOOGLE DRIVE (Sauvegarde Cloud) — OPTIONNEL
# ===========================================
# 1. Projet sur https://console.cloud.google.com/  2. Activer l'API Drive
# 3. Identifiants OAuth 2.0 (Application Web)  4. Ajouter le domaine autorisé
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# ===========================================
# CLAUDE AI (front) — OPTIONNEL
# ===========================================
# La configuration IA se fait normalement dans Paramètres (clé chiffrée) ou
# côté Edge Function claude-proxy. Cette variable n'est qu'un repli front.
VITE_CLAUDE_API_KEY=

# ============================================================================
# EDGE FUNCTIONS — SECRETS SERVEUR (informatif, PAS dans ce .env front)
# ============================================================================
# À définir via : Supabase Dashboard → Edge Functions → Secrets
# (ou `supabase secrets set KEY=valeur`). Jamais exposés au front.
#
#   SUPABASE_SERVICE_ROLE_KEY   — accès service role (claude-proxy, hooks, …)
#
#   # IA (fournisseurs)
#   GROQ_API_KEY                — si Groq est appelé côté serveur
#
#   # Atlas Finance (push des écarts de rapprochement)
#   ATLAS_FINANCE_API_URL       — endpoint API Atlas Finance
#   ATLAS_FINANCE_API_KEY       — bearer token (sinon : repli local propre)
#
#   # Signature électronique (sign-and-send)
#   ADVIST_CLIENT_ID / ADVIST_CLIENT_SECRET / ADVIST_TOKEN_URL / ADVIST_TSA_URL
#
#   # Email transactionnel (Resend)
#   RESEND_API_KEY / RESEND_FROM_EMAIL / RESEND_REPLY_TO
# ============================================================================
